# Copie para .env e preencha:  Copy-Item .env.example .env
# O .env nunca entra no Git. Não coloque valores reais neste arquivo.

# --- API ---
API_BIND=127.0.0.1:8080
DATABASE_URL=sqlite://data/squak.db?mode=rwc
# RUST_LOG=info

# --- LiveKit (voz, vídeo e tela) ---
# scripts/livekit-up.ps1 lê as duas chaves abaixo: sem aspas e sem comentário na mesma linha.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# Troque por um valor longo e aleatório (32+ caracteres), ex.: openssl rand -hex 32
LIVEKIT_API_SECRET=troque-por-um-valor-longo-e-aleatorio

# --- GitHub (ver docs/GITHUB_INTEGRATION.md) ---
# 1 liga o cliente simulado: a integração funciona sem GitHub App. Use 0 com credenciais reais.
GITHUB_MOCK=1
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# 32 bytes em base64, cifra os tokens no banco: openssl rand -base64 32
GITHUB_TOKEN_KEY=
# GITHUB_API_BASE=https://api.github.com

# --- Desktop (Vite) ---
# O Vite lê .env de apps/desktop, não da raiz. Só defina se a API não estiver em 127.0.0.1:8080.
# VITE_API_URL=http://127.0.0.1:8080
